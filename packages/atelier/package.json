{
          "name": "@mrploman/atelier",
          "version": "0.0.1",
          "description": "Catches broken, unused, and inaccessible design tokens before they reach production",
          "type": "module",
          "license": "MIT",
          "sideEffects": false,
          "engines": {
                    "node": ">=22"
          },
          "publishConfig": {
                    "access": "public"
          },
          "exports": {
                    ".": {
                              "types": "./dist/index.d.ts",
                              "import": "./dist/index.js"
                    },
                    "./package.json": "./package.json"
          },
          "main": "./dist/index.js",
          "types": "./dist/index.d.ts",
          "files": [
                    "dist"
          ],
          "scripts": {
                    "build": "tsdown",
                    "test": "vitest run",
                    "test:watch": "vitest",
                    "typecheck": "tsc --noEmit"
          },
          "devDependencies": {
                    "tsdown": "^0.9.0",
                    "tsx": "^4.23.9",
                    "typescript": "^5.9.0",
                    "vitest": "^3.0.0"
          }
}