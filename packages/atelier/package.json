{
                "name": "@mrploman/atelier",
                "version": "1.0.1",
                "description": "TypeScript-first design token pipeline: parse, resolve, validate, transform and generate CSS/SCSS/TS from DTCG token documents.",
                "type": "module",
                "sideEffects": false,
                "bin": {
                                "atelier": "./dist/cli.js"
                },
                "exports": {
                                ".": {
                                                "types": {
                                                                "import": "./dist/index.d.mts",
                                                                "require": "./dist/index.d.cts"
                                                },
                                                "import": "./dist/index.mjs",
                                                "require": "./dist/index.cjs"
                                }
                },
                "main": "./dist/index.cjs",
                "module": "./dist/index.mjs",
                "types": "./dist/index.d.mts",
                "files": [
                                "dist"
                ],
                "publishConfig": {
                                "access": "public"
                },
                "scripts": {
                                "build": "tsdown"
                },
                "engines": {
                                "node": ">=20.6"
                },
                "devDependencies": {
                                "publint": "^0.3.23",
                                "tsdown": "...",
                                "jiti": "...",
                                "chokidar": "..."
                }
}